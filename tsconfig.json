{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": [
      "./backend/node_modules/@types"
    ]
  },
  "include": [
    "backend/src/**/*",
    "backend/tools/**/*"
  ]
}
