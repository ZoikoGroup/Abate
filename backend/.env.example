# Abate Backend Environment Configuration (.env.example)
# Non-secret defaults; real production secrets come from vault / approved secret management

PORT=5000
NODE_ENV=development
APP_ENV=local # local | test | staging | production
CLIENT_URL=http://localhost:5173

# Database Connections (Separated roles: migrator vs restricted app runtime)
DATABASE_URL_MIGRATOR=postgres://abate_migrator:migrator_pw@localhost:5432/abate
DATABASE_URL_APP=postgres://abate_app:app_pw@localhost:5432/abate
# Outbox drainer: may read all tenants' outbox rows and nothing else (0062_outbox_worker_role.sql)
DATABASE_URL_WORKER=postgres://abate_worker:worker_pw@localhost:5432/abate
DATABASE_URL_IDENTITY=postgres://abate_identity:identity_pw@localhost:5432/abate
DATABASE_URL_PROTECTED_COMPUTE=postgres://abate_protected_compute:protected_compute_pw@localhost:5432/abate
DATABASE_URL_RELEASE_COMPILER=postgres://abate_release_compiler:release_compiler_pw@localhost:5432/abate
DATABASE_URL_PERFORMANCE=postgres://abate_performance:performance_pw@localhost:5432/abate
DATABASE_URL_OPS=postgres://abate_ops:ops_pw@localhost:5432/abate
# Dedicated least-privilege Platform Super Admin DB role (0094_platform_admin_role_and_governance.sql)
DATABASE_URL_PLATFORM_ADMIN=postgres://abate_platform_admin:platform_admin_pw@localhost:5432/abate

# Admin Session Hardening & Step-Up Re-Authentication (ADR-007)
# ADMIN_SESSION_TTL_SECONDS=900
# ADMIN_STEP_UP_WINDOW_SECONDS=300
# ADMIN_IP_ALLOWLIST=

# Object Store & Storage
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=abate-artifacts

# Authentication (JWT verification and issuance)
AUTH_ISSUER=http://localhost:5000/auth
AUTH_AUDIENCE=abate-api
AUTH_SECRET=dev_secret_key_abate_foundation_do_not_use_in_prod_min_32_chars!
# Support-operator tokens (B8): separate key so a leaked tenant key cannot mint support access
SUPPORT_AUTH_SECRET=dev_support_auth_key_abate_do_not_use_in_prod_min_32_chars!
# Key for subject pseudonyms / erasure tombstones. Required in staging/production (falls back to AUTH_SECRET in local/test only)
PSEUDONYM_SECRET=dev_pseudonym_key_abate_do_not_use_in_prod_min_32_chars!
# Separate key for signed action grants (Phase 6); never reuse AUTH_SECRET in production
ACTION_GRANT_SECRET=dev_action_grant_key_abate_do_not_use_in_prod_min_32_chars!

# Fixed Clock for deterministic synthetic fixtures (used in local/test only)
FIXED_CLOCK=2026-03-02T09:00:00Z

# Rate limiting (per IP, per minute). Disabled in local/test unless set; defaults to 600 elsewhere
# RATE_LIMIT_PER_MIN=600
# Number of reverse-proxy hops to trust for req.ip when behind a load balancer
# TRUST_PROXY=1

# Pilot / Production OIDC & Secret Manager Configuration
# Set ABATE_DISABLE_DEV_TOKEN=1 to verify OIDC-only login locally (automatically enforced in staging/production)
# ABATE_DISABLE_DEV_TOKEN=0
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/authorize
# OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth/token
# OIDC_CLIENT_ID=abate-pilot-web
# OIDC_PUBLIC_KEY_PEM=
# OIDC_JWKS_JSON=
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_ROLE_CLAIM=role
#
# Secret manager mounts (JSON bundle file or directory with KEY files)
# ABATE_SECRETS_FILE=/run/secrets/abate-secrets.json
# ABATE_SECRETS_DIR=/run/secrets
#
# Monitoring & structured logs (automatically enabled in staging/production)
# ABATE_STRUCTURED_LOGS=1
# METRICS_AUTH_TOKEN=
# ALERT_WEBHOOK_URL=
