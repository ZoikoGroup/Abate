# Abate Backend Environment Configuration (.env.example)
# Non-secret defaults; real production secrets come from vault / approved secret management

PORT=5000
NODE_ENV=development
APP_ENV=local # local | test | staging | production
CLIENT_URL=http://localhost:5173

# Database Connections (Separated roles: migrator vs restricted app runtime)
DATABASE_URL_MIGRATOR=postgres://abate_migrator:migrator_pw@localhost:5432/abate
DATABASE_URL_APP=postgres://abate_app:app_pw@localhost:5432/abate
# Outbox drainer: may read all tenants' outbox rows and nothing else (0062_outbox_worker_role.sql)
DATABASE_URL_WORKER=postgres://abate_worker:worker_pw@localhost:5432/abate

# Object Store & Storage
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=abate-artifacts

# Authentication (JWT verification and issuance)
AUTH_ISSUER=http://localhost:5000/auth
AUTH_AUDIENCE=abate-api
AUTH_SECRET=dev_secret_key_abate_foundation_do_not_use_in_prod_min_32_chars!
# Support-operator tokens (B8): separate key so a leaked tenant key cannot mint support access
SUPPORT_AUTH_SECRET=dev_support_auth_key_abate_do_not_use_in_prod_min_32_chars!
# Separate key for signed action grants (Phase 6); never reuse AUTH_SECRET in production
ACTION_GRANT_SECRET=dev_action_grant_key_abate_do_not_use_in_prod_min_32_chars!

# Fixed Clock for deterministic synthetic fixtures (used in local/test only)
FIXED_CLOCK=2026-03-02T09:00:00Z
